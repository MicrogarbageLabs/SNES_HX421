 void cli_entrycheck() {
+#ifdef HX421_DEV_TERMINAL
+  /* dev terminal over USB CDC: enter the CLI on ANY key (not just ESC), and
+   * print a banner so the keypress produces visible output — proving the USB
+   * terminal TX path end to end. */
+  if(uart_gotc()) {
+    uart_getc();                 /* consume the keystroke */
+    printf("\r\n*** HX-421 dev terminal CLI ready (type ? for help) ***\r\n");
+    cli_loop();
+    return;
+  }
+  /* proof-of-life heartbeat: printed periodically to the USB terminal so that
+   * simply opening PuTTY shows the dev firmware is alive and TX works, with no
+   * keypress or CLI entry needed. This poll runs ~50 Hz in menu_main_loop. */
+  static uint32_t hb = 0;
+  if((++hb % 100u) == 0u)
+    printf("[HX-421 dev terminal alive - press any key for CLI]\r\n");
+#else
   if(uart_gotc() && uart_getc() == 27) {
     printf("*** BREAK\n");
     cli_loop();
   }
+#endif
 }
 
 void cli_loop(void) {
