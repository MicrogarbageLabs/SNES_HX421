+/* HX-421 dev-mode: load a packed .hxg from SD into the game region and run it.
+ * The game's own file syscalls are confined to a fixed dev sandbox. Blocks until
+ * the game returns (USB/CDC is not serviced during the run yet -- fw_yield is a
+ * stub -- so use games that return for now). */
+void cmd_run(void) {
+  if(*curchar == 0) {
+    printf("Usage: run <file.hxg>\n");
+    return;
+  }
+  printf("loading %s ...\n", curchar);
+  int r = hx421_fw_run_game(curchar, "/sd2snes/hx421");
+  if(r == 0) {
+    printf("game returned OK\n");
+  } else {
+    printf("load/run failed: %d\n", r);
+  }
+}
