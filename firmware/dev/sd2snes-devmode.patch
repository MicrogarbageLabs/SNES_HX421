@@ -8,6 +8,9 @@
 #include "bits.h"
 #include "uart.h"
 #include "led.h"
+#ifdef HX421_DEV_TERMINAL
+#include "hx421_termcdc.h"   /* dev-mode: the console lives on the USB CDC port */
+#endif
 
 static volatile unsigned int read_idx,write_idx;
 
@@ -16,18 +19,35 @@ void uart_putc(char c) {
     uart_putc('\r');
   while(!(BITBAND(UART_REGS->SR, USART_SR_TXE_Pos)));
   UART_REGS->DR = c;
+#ifdef HX421_DEV_TERMINAL
+  term_putc(c);              /* tee to the USB terminal (physical UART still driven) */
+#endif
 }
 
 /* Polling version only */
 unsigned char uart_getc(void) {
+#ifdef HX421_DEV_TERMINAL
+  /* take whichever source has a byte first: USB terminal or physical UART */
+  for (;;) {
+    if (term_avail())
+      return (unsigned char)term_getc();
+    if (BITBAND(UART_REGS->SR, USART_SR_RXNE_Pos))
+      return UART_REGS->DR;
+  }
+#else
   /* wait for character */
   while (!(BITBAND(UART_REGS->SR, USART_SR_RXNE_Pos))) ;
   return UART_REGS->DR;
+#endif
 }
 
 /* Returns true if a char is ready */
 unsigned char uart_gotc(void) {
+#ifdef HX421_DEV_TERMINAL
+  return (BITBAND(UART_REGS->SR, USART_SR_RXNE_Pos) || term_avail());
+#else
   return BITBAND(UART_REGS->SR, USART_SR_RXNE_Pos);
+#endif
 }
 
